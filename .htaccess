# =====================================================================
#  Bubble Fiesta – podešavanja za Apache (shared hosting)
#  Kanonska adresa: https://www.igraonica-bubblefiesta.rs/
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTP -> HTTPS i bez-www -> www (jedan 301 skok)
  #    (X-Forwarded-Proto za hostinge iza proxy-ja / Cloudflare-a)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.igraonica-bubblefiesta.rs%{REQUEST_URI} [L,R=301,NE]

  # 2) izvorni fajlovi sajta nisu javni (alati, podaci, šabloni, dokumentacija)
  RewriteRule ^(tools|data|templates|docs|google-apps-script)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|\.git.*)$ - [R=404,L]

  # 3) /index.html -> /
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://www.igraonica-bubblefiesta.rs/ [L,R=301]

  # 4) /stranica.html -> /stranica (čisti URL-ovi)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ https://www.igraonica-bubblefiesta.rs/%1 [L,R=301,NE]

  # 5) /stranica/ (kosa crta na kraju) -> /stranica
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://www.igraonica-bubblefiesta.rs/$1 [L,R=301]

  # 6) /stranica -> interno služi stranica.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ /$1.html [L]

</IfModule>

# ---------------------------------------------------------------------
#  Tipovi fajlova
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType video/mp4 .mp4
  AddType image/x-icon .ico
</IfModule>

# ---------------------------------------------------------------------
#  Kompresija: Brotli ako ga hosting podržava, inače gzip
# ---------------------------------------------------------------------
<IfModule mod_brotli.c>
  # Brotli za pregledače koji ga podržavaju, gzip za ostale
  AddOutputFilterByType BROTLI_COMPRESS;DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml image/x-icon
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json application/manifest+json image/svg+xml image/x-icon
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------
#  Keširanje
#  HTML: uvek provera nove verzije. CSS/JS: 1 mesec (nemaju hash u imenu –
#  posle izmene dodaj ?v=2 u link). Slike, fontovi, video: 1 godina.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/plain                "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType text/javascript           "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg|ico|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Bezbednosna zaglavlja
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS – uključi tek kada HTTPS radi na www i bez-www adresi:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  Header unset ETag
</IfModule>
FileETag None
